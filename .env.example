# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.
ANTHROPIC_API_KEY=
# Modelo de Claude a usar (opcional)
JARVIS_MODEL=claude-sonnet-5-5

# Zona horaria IANA, por ejemplo America/Bogota (opcional; vacío = la del sistema)
JARVIS_TIMEZONE=

# Fuente de reuniones: sample (datos de ejemplo) o google (Google Calendar real)
JARVIS_CALENDAR=sample

# Google Calendar (solo si JARVIS_CALENDAR=google)
# ID del calendario a leer; "primary" es tu calendario principal
GOOGLE_CALENDAR_ID=primary
# Rutas opcionales; por defecto ~/.config/jarvis/credentials.json y ~/.config/jarvis/token.json
GOOGLE_CREDENTIALS_FILE=
GOOGLE_TOKEN_FILE=

# Resumen diario por correo (v0.3). Vacío = desactivado.
# Correo al que JARVIS envía el resumen (normalmente el tuyo)
JARVIS_RESUMEN_DESTINATARIO=
# Hora del envío, de lunes a viernes (HH:MM)
JARVIS_RESUMEN_HORA=07:00
# Base de datos local (opcional; por defecto ~/.config/jarvis/jarvis.db)
JARVIS_DB_PATH=

# WhatsApp (v0.4): chatear con JARVIS con la WhatsApp Cloud API de Meta.
# Token permanente de un usuario del sistema (no el temporal de 24 h)
WHATSAPP_ACCESS_TOKEN=
# "Identificador del número de teléfono" en WhatsApp → Configuración de la API
WHATSAPP_PHONE_NUMBER_ID=
# Configuración de la app → Básica → Clave secreta de la app
WHATSAPP_APP_SECRET=
# Texto aleatorio que tú inventas y pegas también en la configuración del webhook en Meta
WHATSAPP_VERIFY_TOKEN=
# Tu número con código de país (el único que JARVIS atiende), por ejemplo 573001234567
WHATSAPP_OWNER_NUMBER=
# Puerto local del servidor (opcional)
WHATSAPP_PORT=8000
# Versión de la Graph API (opcional)
WHATSAPP_API_VERSION=v25.0
