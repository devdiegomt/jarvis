# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.
ANTHROPIC_API_KEY=
# Modelo de Claude a usar (opcional)
JARVIS_MODEL=claude-sonnet-5-5

# Zona horaria IANA, por ejemplo America/Bogota (opcional; vacío = la del sistema)
JARVIS_TIMEZONE=

# Fuente de reuniones: sample (datos de ejemplo) o google (Google Calendar real)
JARVIS_CALENDAR=sample

# Google Calendar (solo si JARVIS_CALENDAR=google)
# ID del calendario a leer; "primary" es tu calendario principal
GOOGLE_CALENDAR_ID=primary
# Rutas opcionales; por defecto ~/.config/jarvis/credentials.json y ~/.config/jarvis/token.json
GOOGLE_CREDENTIALS_FILE=
GOOGLE_TOKEN_FILE=

# Resumen diario (lunes a viernes)
# Canal del resumen: telegram o gmail
JARVIS_RESUMEN_CANAL=telegram
# Solo con JARVIS_RESUMEN_CANAL=gmail: correo que recibe el resumen (vacío = desactivado)
JARVIS_RESUMEN_DESTINATARIO=
# Hora del envío, de lunes a viernes (HH:MM)
JARVIS_RESUMEN_HORA=07:00
# Base de datos local (opcional; por defecto ~/.config/jarvis/jarvis.db)
JARVIS_DB_PATH=

# Telegram: chatear con JARVIS y (opcional) recibir el resumen diario.
# Token del bot que te da @BotFather al crearlo
TELEGRAM_BOT_TOKEN=
# Tu ID numérico de Telegram: ejecuta `uv run jarvis telegram-vincular` para obtenerlo
TELEGRAM_OWNER_ID=

# Notas de voz por Telegram (transcripción en tu PC). Activar: `uv run jarvis preparar-voz`
# Motor de transcripción: local (Whisper en el PC) o no (desactivadas)
JARVIS_TRANSCRIPCION=local
# Modelo de Whisper: tiny, base, small, medium, large-v3-turbo… (más grande = más preciso y lento)
JARVIS_WHISPER_MODELO=small
# Respuestas con voz (Piper en tu PC): local o no (desactivadas). /voz en Telegram elige cuándo.
JARVIS_RESPUESTA_VOZ=local
# Voz de Piper; muestras en https://rhasspy.github.io/piper-samples/
JARVIS_PIPER_VOZ=es_MX-ald-medium

# "Hey JARVIS" en el PC (micrófono y parlantes). Pruébalo antes con `uv run python -m jarvis escuchar`.
# si = escuchar en segundo plano; no = apagado (por defecto)
JARVIS_PALABRA_ACTIVACION=no
# Sensibilidad (0 a 1): más alto, menos activaciones por error; más bajo, se activa más fácil
JARVIS_ACTIVACION_UMBRAL=0.5
